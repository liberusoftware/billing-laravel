{
  "name": "liberusoftware/billing-catalog-api",
  "description": "HTTP API adapter for the Liberu Billing Catalog module.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/http": "^13.0",
    "illuminate/routing": "^13.0",
    "laravel/sanctum": "^4.0",
    "liberusoftware/billing-catalog": "^0.1",
    "liberusoftware/module-manager": "^1.0"
  },
  "autoload": {"psr-4": {"Liberu\\Billing\\Catalog\\Api\\": "src/"}},
  "extra": {"liberu": {"name": "billing-catalog-api"}},
