{
  "name": "liberusoftware/module-billing-provisioning-api",
  "description": "HTTP API adapter for Liberu Billing Provisioning.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/http": "^13.0",
    "illuminate/routing": "^13.0",
    "laravel/sanctum": "^4.0",
    "liberusoftware/module-billing-provisioning": "^0.1",
    "liberusoftware/module-manager": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Billing\\Provisioning\\Api\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "module-billing-provisioning-api"
    }
  },
  "version": "0.1.0",
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
